{
  "name": "chessbot",
  "version": "2.7.1",
  "private": true,
  "description": "Chess.com and Lichess analysis overlay built with React, TypeScript, SCSS and local Stockfish 19.",
  "type": "module",
  "scripts": {
    "postinstall": "tsx scripts/prepare-vendor.ts",
    "prebuild": "tsx scripts/prepare-vendor.ts",
    "icons": "tsx scripts/icons.ts",
    "build": "tsx scripts/build.ts",
    "check": "tsc --noEmit && tsx scripts/check-comments.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/browser-test.ts"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stockfish": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "0.3.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "sass": "^1.105.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}
